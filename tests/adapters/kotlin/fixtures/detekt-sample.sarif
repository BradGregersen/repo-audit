        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "kt/Bad.kt"
                },
                "region": {
                  "endColumn": 19,
                  "endLine": 24,
                  "startColumn": 9,
                  "startLine": 24
                }
              }
            }
          ],
          "message": {
            "text": "Calling !! on a nullable type will throw a NullPointerException at runtime in case the value is null. Use a safe call ?. or handle the null case explicitly."
          },
          "ruleId": "detekt.potential-bugs.UnsafeCallOnNullableType"
        }
      ],
      "tool": {
        "driver": {
          "downloadUri": "https://github.com/detekt/detekt/releases/download/v1.23.8/detekt",
          "fullName": "detekt",
          "guid": "022ca8c2-f6a2-4c95-b107-bb72c43263f3",
          "informationUri": "https://detekt.dev",
          "language": "en",
          "name": "detekt",
          "organization": "detekt",
          "rules": [
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/style.html#magicnumber",
              "id": "detekt.style.MagicNumber",
              "name": "MagicNumber",
              "shortDescription": {
                "text": "Report magic numbers. Magic number is a numeric literal that is not defined as a constant and hence it's unclear what the purpose of this number is. It's better to declare such numbers as constants and give them a proper name. By default, -1, 0, 1, and 2 are not considered to be magic numbers."
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/potential-bugs.html#unsafecallonnullabletype",
              "id": "detekt.potential-bugs.UnsafeCallOnNullableType",
              "name": "UnsafeCallOnNullableType",
              "shortDescription": {
                "text": "Reports unsafe calls on nullable types. These calls will throw a NullPointerException in case the nullable value is null."
              }
            }
          ],
          "semanticVersion": "1.23.8",
          "version": "1.23.8"
        }
      }
    }
  ]
