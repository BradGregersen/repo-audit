{
  "$schema": "http://json.schemastore.org/sarif-2.1.0",
  "runs": [
    {
      "defaultSourceLanguage": "dockerfile",
      "results": [
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "-"
                },
                "region": {
                  "endColumn": 1,
                  "endLine": 1,
                  "sourceLanguage": "dockerfile",
                  "startColumn": 1,
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "Always tag the version of an image explicitly"
          },
          "ruleId": "DL3006"
        },
        {
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "-"
                },
                "region": {
                  "endColumn": 1,
                  "endLine": 2,
                  "sourceLanguage": "dockerfile",
                  "startColumn": 1,
                  "startLine": 2
                }
              }
            }
          ],
          "message": {
            "text": "Delete the apt lists (/var/lib/apt/lists) after installing something"
          },
          "ruleId": "DL3009"
        }
      ],
      "tool": {
        "driver": {
          "downloadUri": "https://github.com/hadolint/hadolint",
          "fullName": "Haskell Dockerfile Linter",
          "name": "Hadolint",
          "shortDescription": {
            "text": "Dockerfile linter, validate inline bash, written in Haskell"
          },
          "version": "2.14.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}
