{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ggshield",
          "version": "1.34.0",
          "informationUri": "https://github.com/GitGuardian/ggshield",
          "rules": [
            {
              "id": "generic_high_entropy_secret",
              "name": "GenericHighEntropySecret",
              "shortDescription": {
                "text": "Generic high-entropy secret detected"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": ["security", "secret"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "generic_high_entropy_secret",
          "level": "error",
          "message": {
            "text": "A high-entropy secret was committed (value redacted)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config/settings.py"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
